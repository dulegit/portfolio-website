---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/base-layout.astro";
import { About, Hero, Steps } from "@/components/modules";

const page = await getEntry("pages", "home");
if (!page) return Astro.redirect("/404");
const { seo, header, hero, steps, about } = page.data;
---

<BaseLayout
  title={seo?.title ?? page.data.title}
  description={seo?.description}
  header={header}
>
  <main>
    {hero && <Hero {...hero} />}
    {steps && <Steps {...steps} />}
    {about && <About {...about} />}
  </main>
</BaseLayout>
