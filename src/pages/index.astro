---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/base-layout.astro";
import { Hero } from "@/components/modules";

const page = await getEntry("pages", "home");
if (!page) return Astro.redirect("/404");
const { hero, seo } = page.data;
---

<BaseLayout title={seo?.title ?? page.data.title} description={seo?.description}>
  <main>
    {hero && <Hero {...hero} />}
  </main>
</BaseLayout>
