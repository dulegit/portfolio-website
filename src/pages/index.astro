---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/base-layout.astro";
import { Companies, Contact, Hero, SelectedWork, Stack, Writing } from "@/components/modules";

const page = await getEntry("pages", "home");
if (!page) return Astro.redirect("/404");
const { seo, header, hero, companies, stack, work, writing, contact } = page.data;
---

<BaseLayout
  title={seo?.title ?? page.data.title}
  description={seo?.description}
  header={header}
>
  <main>
    {hero && <Hero {...hero} />}
    {companies && <Companies {...companies} />}
    {stack && <Stack {...stack} />}
    {work && <SelectedWork {...work} />}
    {writing && <Writing {...writing} />}
    {contact && <Contact {...contact} />}
  </main>
</BaseLayout>
