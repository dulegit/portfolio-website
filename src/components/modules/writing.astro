---
import Container from "@/components/primitives/container.astro";
import { cn } from "@/lib/utils";

export interface WritingEntry {
  title: string;
  description: string;
  date: string;
  href: string;
  external?: boolean;
}

export interface Props {
  sectionNum: string;
  sectionName: string;
  heading: string;
  subtitle: string;
  entries?: WritingEntry[];
  class?: string;
}

const {
  sectionNum,
  sectionName,
  heading,
  subtitle,
  entries,
  class: className,
} = Astro.props;

const hasEntries = entries && entries.length > 0;
---

<section id="writing" class={cn("pt-16 md:pt-32", className)}>
  <Container>
    <div class="flex flex-col gap-12">
      <!-- Section label + heading (same pattern as Selected Work) -->
      <div
        class="flex flex-col gap-4 md:grid md:grid-cols-[180px_1fr] md:gap-x-8"
      >
        <div class="self-start md:pt-2">
          <p
            class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px]"
          >
            <span class="text-primary">{sectionNum}</span>
            <span class="text-foreground"> {sectionName}</span>
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <h2
            class="font-sans font-bold text-[2rem] leading-[1.28] text-foreground md:text-[2.5rem]"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {heading}
          </h2>
          <p
            class="font-sans text-[1.1875rem] leading-[1.44] text-muted-foreground"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {subtitle}
          </p>
        </div>
      </div>

      <!-- Article list: border-b wraps the list; each entry has border-t -->
      <div class="border-b border-border">
        {hasEntries ? (
          entries.map(({ title, description, date, href, external }) => (
            <article class="border-t border-border">
              <a
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="group flex flex-col gap-3 py-6 md:flex-row md:items-baseline md:gap-8 md:py-8"
              >
                <div class="flex min-w-0 flex-1 flex-col gap-3">
                  <h3
                    class="font-sans font-semibold text-[1.375rem] leading-[1.28] text-foreground transition-colors group-hover:text-brown-200 md:text-[1.75rem]"
                    style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                  >
                    {title}
                    <span
                      class="ml-1 inline-block text-muted-foreground transition-transform group-hover:translate-x-0.5"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </h3>
                  <p
                    class="font-sans text-base leading-[1.28] text-muted-foreground"
                    style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                  >
                    {description}
                  </p>
                </div>
                <p class="shrink-0 font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-muted-foreground md:w-32 md:text-right">
                  {date}
                </p>
              </a>
            </article>
          ))
        ) : (
          <article class="border-t border-border">
            <div class="flex flex-col gap-3 py-6 md:flex-row md:items-baseline md:gap-8 md:py-8">
              <div class="flex min-w-0 flex-1 flex-col gap-3">
                <h3
                  class="font-sans font-semibold text-[1.375rem] leading-[1.28] text-muted-foreground md:text-[1.75rem]"
                  style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                >
                  First post coming soon
                </h3>
                <p
                  class="font-sans text-base leading-[1.28] text-muted-foreground"
                  style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                >
                  I'm working on my first write-up. Check back shortly.
                </p>
              </div>
              <p class="shrink-0 font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-muted-foreground md:w-32 md:text-right">
                Soon
              </p>
            </div>
          </article>
        )}
      </div>
    </div>
  </Container>
</section>
