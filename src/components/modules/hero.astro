---
import Container from "@/components/primitives/container.astro";
import { cn } from "@/lib/utils";

export interface Props {
  name: string;
  title: string;
  location: string;
  description: string;
  class?: string;
}

const { name, title, location, description, class: className } = Astro.props;
---

<section class={cn("py-16 md:py-24 lg:py-32", className)}>
  <Container>
    <div class="flex flex-col gap-8 md:gap-12">
      <div class="flex items-center gap-4">
        <span class="h-px w-14 shrink-0 bg-primary" aria-hidden="true"></span>
        <p
          class="font-mono text-xs font-medium uppercase tracking-wider text-muted-foreground"
        >
          {title} · {location}
        </p>
      </div>

      <div class="flex flex-col gap-8 md:gap-12 max-w-2xl">
        <div class="relative">
          <div
            class="pointer-events-none absolute -top-48 -left-14 size-[520px] blur-2xl opacity-50"
            aria-hidden="true"
            style="background: radial-gradient(ellipse at center, rgba(169,77,55,0.55) 16%, rgba(85,39,28,0.275) 50%, transparent 83%)"
          >
          </div>
          <h1
            class="relative font-sans font-black text-4xl lg:text-5xl leading-[1.28]"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            <span class="text-brown-200">{name}</span>
            <br />
            <span class="text-foreground">{title}</span>
          </h1>
        </div>

        <p
          class="font-sans text-[1.1875rem] leading-[1.44] text-foreground"
          style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
        >
          {description}
        </p>
      </div>
    </div>
  </Container>
</section>
