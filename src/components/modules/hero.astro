---
import Container from "@/components/primitives/container.astro";
import { cn } from "@/lib/utils";

export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  name: string;
  title: string;
  location: string;
  description: string;
  stats?: Stat[];
  class?: string;
}

const {
  name,
  title,
  location,
  description,
  stats,
  class: className,
} = Astro.props;
---

<section class={cn("pt-16 md:pt-32 overflow-x-clip", className)}>
  <Container>
    <div class="flex flex-col gap-8 md:gap-12">
      <div class="flex items-center gap-4">
        <span class="h-px w-14 shrink-0 bg-primary" aria-hidden="true"></span>
        <p
          class="font-mono text-xs font-medium uppercase tracking-wider text-muted-foreground"
        >
          {title} · {location}
        </p>
      </div>

      <div class="flex flex-col gap-8 md:gap-12 max-w-2xl">
        <div class="relative">
          <div
            class="pointer-events-none absolute -top-48 -left-14 size-[520px] blur-2xl opacity-50"
            aria-hidden="true"
            style="background: radial-gradient(ellipse at center, rgba(169,77,55,0.55) 16%, rgba(85,39,28,0.275) 50%, transparent 83%)"
          >
          </div>
          <h1
            class="relative font-sans font-black text-5xl leading-[1.28]"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            <span class="text-brown-200">{name}</span>
            <br />
            <span class="text-foreground">{title}</span>
          </h1>
        </div>

        <p
          class="font-sans text-[1.1875rem] leading-[1.44] text-foreground"
          style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
        >
          {description}
        </p>
      </div>

      {
        stats && stats.length > 0 && (
          <div class="border-b md:border-t border-border">
            <div class="flex flex-col md:flex-row md:divide-x md:divide-border">
              {stats.map(({ value, label: statLabel }, i) => (
                <div
                  class={cn(
                    "flex flex-1 flex-col gap-2 py-6",
                    i === 0 ? "md:pr-6" : "md:px-6",
                  )}
                >
                  <p
                    class="font-sans font-semibold text-[1.75rem] leading-[1.28] text-foreground"
                    style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                  >
                    {value}
                  </p>
                  <p class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-muted-foreground">
                    {statLabel}
                  </p>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </Container>
</section>
