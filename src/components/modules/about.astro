---
import Container from "@/components/primitives/container.astro";
import { cn } from "@/lib/utils";

export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  sectionNum: string;
  sectionName: string;
  heading: string;
  subtitle: string;
  paragraphs: string[];
  stats: Stat[];
  class?: string;
}

const {
  sectionNum,
  sectionName,
  heading,
  subtitle,
  paragraphs,
  stats,
  class: className,
} = Astro.props;
---

<section id="about" class={cn("pb-12 md:pb-24", className)}>
  <Container>
    <div class="flex flex-col gap-12">
      <!-- Section label + heading -->
      <div
        class="flex flex-col gap-4 md:grid md:grid-cols-[180px_1fr] md:gap-x-8"
      >
        <div class="self-start md:pt-[9px]">
          <p
            class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px]"
          >
            <span class="text-primary">{sectionNum}</span>
            <span class="text-foreground"> {sectionName}</span>
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <h2
            class="font-sans font-bold text-[2rem] leading-[1.28] text-foreground md:text-[2.5rem]"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {heading}
          </h2>
          <p
            class="font-sans text-[1.1875rem] leading-[1.44] text-muted-foreground"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {subtitle}
          </p>
        </div>
      </div>

      <!-- Body paragraphs — indented on desktop to align with the content column -->
      <div class="flex flex-col gap-6 md:ml-[calc(180px+2rem)]">
        {
          paragraphs.map((para) => (
            <p
              class="font-sans text-base leading-[1.28] text-foreground"
              style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
            >
              {para}
            </p>
          ))
        }
      </div>

      <!-- Stats bar -->
      <div class="border-b border-t border-border">
        <div
          class="flex flex-col divide-y divide-border md:flex-row md:divide-x md:divide-y-0"
        >
          {
            stats.map(({ value, label: statLabel }, i) => (
              <div
                class={cn(
                  "flex flex-1 flex-col gap-2 py-6",
                  i === 0 ? "md:pr-6" : "md:px-6",
                )}
              >
                <p
                  class="font-sans font-semibold text-[1.75rem] leading-[1.28] text-foreground"
                  style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                >
                  {value}
                </p>
                <p class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-muted-foreground">
                  {statLabel}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
