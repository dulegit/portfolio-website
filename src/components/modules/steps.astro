---
import Container from "@/components/primitives/container.astro";
import { cn } from "@/lib/utils";

export interface Step {
  num: string;
  heading: string;
  body: string;
}

export interface StepLink {
  label: string;
  href: string;
  arrow: string;
  external?: boolean;
}

export interface Props {
  steps: Step[];
  links: StepLink[];
  class?: string;
}

const { steps, links, class: className } = Astro.props;
---

<section class={cn("", className)}>
  <Container>
    <!-- Card row: top/bottom border wraps the grid; divide handles internal separators -->
    <div class="border-t border-b border-border">
      <div
        class="flex flex-col divide-y divide-border md:flex-row md:divide-y-0 md:divide-x"
      >
        {
          steps.map(({ num, heading, body }, i) => (
            <div
              class={cn(
                "flex flex-1 flex-col gap-4 py-8",
                i === 0 ? "md:pr-8" : "md:p-8",
              )}
            >
              <p class="font-mono text-xs font-medium uppercase tracking-wider text-primary leading-none">
                {num}
              </p>
              <h3
                class="font-sans font-bold text-[2.0625rem] leading-[1.28] text-foreground"
                style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
              >
                {heading}
              </h3>
              <p
                class="font-sans text-base leading-[1.28] text-muted-foreground"
                style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
              >
                {body}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Links row -->
    <div class="flex flex-wrap items-center gap-8 pt-8">
      {
        links.map(({ label, href, arrow, external }) => (
          <a
            href={href}
            class="flex items-center gap-2 border-b border-border pb-2 transition-opacity hover:opacity-70"
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
          >
            <span class="font-mono text-xs font-medium uppercase tracking-wider text-foreground leading-none">
              {label}
            </span>
            <span
              class="font-mono text-xs font-medium uppercase tracking-wider text-primary leading-none"
              aria-hidden="true"
            >
              {arrow}
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
