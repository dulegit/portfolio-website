---
import Container from "@/components/primitives/container.astro";
import Badge from "@/components/primitives/badge.astro";
import { cn } from "@/lib/utils";

export interface ExpertiseCard {
  title: string;
  index: string;
  description: string;
  tags: string[];
}

export interface Props {
  sectionNum: string;
  sectionName: string;
  heading: string;
  subtitle: string;
  cards: ExpertiseCard[];
  class?: string;
}

const { sectionNum, sectionName, heading, subtitle, cards, class: className } =
  Astro.props;
---

<section id="expertise" class={cn("pt-16 md:pt-32", className)}>
  <Container>
    <div class="flex flex-col gap-12">

      <!-- Section label + heading (mirrors about.astro layout) -->
      <div class="flex flex-col gap-4 md:grid md:grid-cols-[180px_1fr] md:gap-x-8">
        <div class="self-start md:pt-2">
          <p class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px]">
            <span class="text-primary">{sectionNum}</span>
            <span class="text-foreground"> {sectionName}</span>
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <h2
            class="font-sans font-bold text-[2rem] leading-[1.28] text-foreground md:text-[2.5rem]"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {heading}
          </h2>
          <p
            class="font-sans text-[1.1875rem] leading-[1.44] text-muted-foreground"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {subtitle}
          </p>
        </div>
      </div>

      <!-- Cards grid
           Border logic:
           - border-t on the wrapper = top rule across full width
           - border-b on every card = horizontal separators
           - md:border-r on even-indexed cards = vertical divider between columns
      -->
      <div class="grid grid-cols-1 md:border-t border-b md:border-b-0 border-border md:grid-cols-2">
        {
          cards.map((card, i) => (
            <div
              class={cn(
                "flex flex-col gap-6 md:border-b border-border p-6 md:p-8",
                i % 2 === 0 && "md:border-r",
              )}
            >
              <!-- Title + index number -->
              <div class="flex items-start justify-between gap-4">
                <h3
                  class="font-sans font-semibold text-[1.5rem] leading-[1.28] text-foreground md:text-[1.75rem]"
                  style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                >
                  {card.title}
                </h3>
                <span
                  class="shrink-0 pt-1 font-mono text-xs font-medium uppercase tracking-[0.6px] text-muted"
                  aria-hidden="true"
                >
                  {card.index}
                </span>
              </div>

              <!-- Description -->
              <p
                class="font-sans text-base leading-[1.28] text-muted-foreground"
                style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
              >
                {card.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-3">
                {card.tags.map((tag) => (
                  <Badge variant="secondary" class="font-mono font-normal py-1">
                    {tag}
                  </Badge>
                ))}
              </div>
            </div>
          ))
        }
      </div>

    </div>
  </Container>
</section>
