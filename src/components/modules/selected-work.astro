---
import Container from "@/components/primitives/container.astro";
import { cn } from "@/lib/utils";

export interface WorkEntry {
  title: string;
  description: string;
  role: string;
  stack: string;
  outcome: string;
}

export interface Props {
  sectionNum: string;
  sectionName: string;
  heading: string;
  subtitle: string;
  entries: WorkEntry[];
  class?: string;
}

const { sectionNum, sectionName, heading, subtitle, entries, class: className } = Astro.props;
---

<section id="work" class={cn("pt-16 md:pt-32", className)}>
  <Container>
    <div class="flex flex-col gap-12">

      <!-- Section label + heading (same pattern as About / Experience) -->
      <div class="flex flex-col gap-4 md:grid md:grid-cols-[180px_1fr] md:gap-x-8">
        <div class="self-start md:pt-2">
          <p class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px]">
            <span class="text-primary">{sectionNum}</span>
            <span class="text-foreground"> {sectionName}</span>
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <h2
            class="font-sans font-bold text-[2rem] leading-[1.28] text-foreground md:text-[2.5rem]"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {heading}
          </h2>
          <p
            class="font-sans text-[1.1875rem] leading-[1.44] text-muted-foreground"
            style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
          >
            {subtitle}
          </p>
        </div>
      </div>

      <!-- Article list: border-b wraps the list; each article has border-t -->
      <div class="border-b border-border">
        {entries.map(({ title, description, role, stack, outcome }) => (
          <article class="md:border-t border-border">
            <div class="flex flex-col gap-6 py-6 md:flex-row md:gap-8 md:py-8">

              <!-- Main: title + description -->
              <div class="flex min-w-0 flex-1 flex-col gap-3">
                <h3
                  class="font-sans font-semibold text-[1.375rem] leading-[1.28] text-foreground md:text-[1.75rem]"
                  style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                >
                  {title}
                </h3>
                <p
                  class="font-sans text-base leading-[1.28] text-muted-foreground"
                  style="font-variation-settings: 'YTLC' 500, 'wdth' 100"
                >
                  {description}
                </p>
              </div>

              <!-- Definition list: Role / Stack / Outcome -->
              <dl class="flex flex-col gap-3 md:w-72 md:shrink-0">
                <div class="flex flex-col gap-0.5">
                  <dt class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-blue-400">Role</dt>
                  <dd class="font-mono text-[0.8125rem] leading-[1.24] text-foreground">{role}</dd>
                </div>
                <div class="flex flex-col gap-0.5">
                  <dt class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-blue-400">Stack</dt>
                  <dd class="font-mono text-[0.8125rem] leading-[1.24] text-foreground">{stack}</dd>
                </div>
                <div class="flex flex-col gap-0.5">
                  <dt class="font-mono text-xs font-medium uppercase leading-none tracking-[0.6px] text-blue-400">Outcome</dt>
                  <dd class="font-mono text-[0.8125rem] leading-[1.24] text-foreground">{outcome}</dd>
                </div>
              </dl>

            </div>
          </article>
        ))}
      </div>

    </div>
  </Container>
</section>
